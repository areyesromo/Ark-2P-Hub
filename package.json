{
  "name": "ark-2p-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Jackbox-style 1v1 party games: the TV is the screen, phones are the controllers.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "desktop": "electron desktop/main.js",
    "dist:linux": "electron-builder --config desktop/electron-builder.yml --linux",
    "dist:win": "electron-builder --config desktop/electron-builder.yml --win"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "three": "0.184.0",
    "word-list": "^4.1.0"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.15.3",
    "socket.io-client": "^4.8.4"
  },
  "author": "Ark 2P Hub"
}
